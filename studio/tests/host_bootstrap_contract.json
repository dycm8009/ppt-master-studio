{
  "schema": "ppt-master-studio-host-bootstrap-contract/v4",
  "new_project_requires_recovery_bundle": false,
  "resume_requires_verified_evidence_when_state_lost": true,
  "host_capability_detection_required": true,
  "connector_resource_discovery_required": true,
  "preloaded_tool_absence_counts_as_connector_unavailable": false,
  "fresh_sha_must_come_from_current_session_branch_metadata": true,
  "stale_literal_sha_forbidden": true,
  "sha_resolution_order": ["github_connector_after_discovery", "native_web_github_api"],
  "runtime_materialization_order": ["local_verified_runtime_bundle", "github_connector_workflow_artifact_after_discovery", "native_host_release_download", "native_host_exact_sha_archive"],
  "artifact_download_action_must_be_discovered_before_materialization_fail_closed": true,
  "host_download_primitive_is_native_host_file_download": true,
  "release_existence_must_be_checked_for_fresh_sha": true,
  "container_network_fallback_forbidden": true,
  "container_network_failure_counts_as_web_attempt": false,
  "fail_closed_only_after_supported_host_paths_exhausted": true,
  "sha_resolution_failure_must_be_distinct_from_materialization_failure": true,
  "runtime_release_tag_pattern": "studio-runtime-{commit}",
  "runtime_release_asset_pattern": "ppt-master-studio-runtime-{commit}.zip",
  "ordinary_handoff_zip_is_recovery_bundle": false
}
