{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ppt-master-hosted-confirm-poc",
  "main": "worker.js",
  "compatibility_date": "2026-08-27",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/s/*"]
  },
  "kv_namespaces": [
    {
      "binding": "SESSIONS",
      "id": "REPLACE_WITH_KV_NAMESPACE_ID"
    }
  ]
}
