{
  "schema": "ppt-master-studio-host-bootstrap-contract/v6",
  "new_project_requires_recovery_bundle": false,
  "resume_requires_verified_evidence_when_state_lost": true,
  "connector_resource_discovery_required": true,
  "preloaded_tool_absence_counts_as_connector_unavailable": false,
  "fresh_sha_must_come_from_current_session_branch_metadata": true,
  "connector_branch_metadata_authoritative_when_available": true,
  "code_search_commit_page_or_cached_web_cannot_define_current_head": true,
  "stale_literal_sha_forbidden": true,
  "sha_resolution_order": ["github_connector_branch_metadata_after_discovery", "native_web_github_api"],
  "artifact_actions_must_be_discovered_before_failure": true,
  "matching_nonexpired_artifact_must_be_download_attempted": true,
  "runtime_artifact_workflow_head_sha_must_equal_pin": true,
  "runtime_materialization_order": ["local_verified_runtime_bundle", "github_connector_workflow_artifact_after_discovery", "native_host_release_download", "native_host_exact_sha_archive"],
  "container_network_fallback_forbidden": true,
  "container_network_failure_counts_as_web_attempt": false,
  "sha_resolution_failure_must_be_distinct_from_materialization_failure": true,
  "runtime_release_tag_pattern": "studio-runtime-{commit}",
  "runtime_release_asset_pattern": "ppt-master-studio-runtime-{commit}.zip",
  "ordinary_handoff_zip_is_recovery_bundle": false,
  "project_instructions_are_minimal_router_only": true,
  "official_harness_owns_ppt_workflow": true,
  "lazy_supporting_document_loading_required": true,
  "duplicate_studio_authority_documents_allowed": false,
  "runtime_bundle_is_whitelist": true,
  "confirmation_surface_failure_changes_transport_only": true,
  "chat_fallback_requires_explicit_user_confirmation_unless_delegated": true,
  "fallback_notice_counts_as_confirmation": false,
  "assistant_recommendation_counts_as_confirmation": false,
  "silence_counts_as_confirmation": false
}
