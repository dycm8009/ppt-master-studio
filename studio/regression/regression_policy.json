{
  "schema": "ppt-master-studio-regression/v3.2.1",
  "long_deck": {
    "threshold_slides": 18,
    "max_same_composition_consecutive": 2,
    "max_family_ratio": 0.18,
    "max_card_dominant_ratio": 0.3
  },
  "motion": {
    "forbid_deck_wide_auto_animation": true,
    "max_animated_slide_ratio": 0.35,
    "max_rows_per_slide": 3,
    "recommended_max_rows_30_40_slide_deck": 24
  },
  "general_dark_tech": {
    "raster_background_allowed": false,
    "full_bleed_ai_illustration_allowed": false,
    "max_image_area_ratio_per_slide": 0.38,
    "max_image_dominant_slide_ratio": 0.12,
    "max_ai_illustration_slide_ratio": 0.06,
    "images_count_toward_diversity_quota": false
  },
  "static_ui_adapter": {
    "fabricate_official_flask_receipts": false,
    "digest_binding_required": true,
    "stage1_user_confirmation_required_when_static_html": true,
    "stage2_user_confirmation_required_when_static_html": true,
    "deck_review_required_before_qa_when_static_html": true,
    "motion_review_required_when_static_html_and_custom_motion": true,
    "plain_chat_and_delegated_branches_remain_allowed": true,
    "stage2_whole_page_preview_required": true,
    "fixed_visual_style_uses_upstream_svg_preview": true,
    "custom_direction_preview_must_be_labeled_proxy": true
  },
  "portable_recovery": {
    "required_on_chatgpt_serverless_for_resume": true,
    "required_for_brand_new_project_bootstrap": false,
    "planning_snapshot_before_authoring": true,
    "reviewed_snapshot_before_qa": true,
    "motion_snapshot_before_export_when_motion": true,
    "per_file_sha256_required": true,
    "chat_memory_reconstruction_allowed": false,
    "deck_review_html_is_complete_recovery_authority": false,
    "ordinary_handoff_zip_is_recovery_authority": false
  },
  "github_first": {
    "repository": "dycm8009/ppt-master-studio",
    "stable_branch": "studio-main",
    "development_branch": "studio-dev",
    "project_commit_pin_required": true,
    "mid_project_silent_upgrade_allowed": false,
    "uploaded_zip_may_override_github_authority": false,
    "new_project_sha_resolution_order": ["github_connector", "public_github_web_api"],
    "runtime_release_required_on_stable_commit": true,
    "runtime_release_tag_pattern": "studio-runtime-{commit}",
    "runtime_release_asset_pattern": "ppt-master-studio-runtime-{commit}.zip",
    "fail_closed_before_all_sha_resolution_paths_attempted": false
  }
}
